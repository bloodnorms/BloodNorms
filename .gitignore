# ==============================================================================
# BloodNorms — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT FILES — NEVER commit real credentials
# ------------------------------------------------------------------------------
# All .env variants (root and assets)
.env
.env.local
.env.production
.env.staging
.env.development
assets/.env
# Keep the template example files
!.env.example
!assets/.env.example

# ------------------------------------------------------------------------------
# 2. FLUTTER / DART / PUB
# ------------------------------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# ------------------------------------------------------------------------------
# 3. PYTHON (scratch test scripts)
# ------------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# ------------------------------------------------------------------------------
# 4. MISCELLANEOUS OS / EDITOR
# ------------------------------------------------------------------------------
*.class
*.log
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Keys and certificates
*.pem
*.p12
*.key
*.cer
*.crt

# Supabase local state
.branches/
.temp/
supabase/.temp/

# Temp / scratch
*.tmp
*.bak
*_OLD*
*_BACKUP*

node_modules/
**/node_modules/
**/dist/

.vercel
.env*
