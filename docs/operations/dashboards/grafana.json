  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Emergency Voice Calls",
      "type": "gauge",
      "targets": [{ "expr": "voice_calls_active", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 35 },
              { "color": "red", "value": 45 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Uptime (Hours)",
      "type": "stat",
      "targets": [{ "expr": "voice_gateway_uptime_seconds / 3600", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "h", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "title": "Memory Consumption (MB)",
      "type": "timeseries",
      "targets": [
        { "expr": "voice_gateway_memory_bytes{type=\"heap_used\"} / 1024 / 1024", "legendFormat": "Heap Used", "refId": "A" },
        { "expr": "voice_gateway_memory_bytes{type=\"rss\"} / 1024 / 1024", "legendFormat": "RSS", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "title": "Voice Call Outcomes",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(voice_calls_total{status=\"completed\"}[5m])", "legendFormat": "Completed", "refId": "A" },
        { "expr": "rate(voice_calls_total{status=\"failed\"}[5m])", "legendFormat": "Failed", "refId": "B" },
        { "expr": "rate(voice_calls_total{status=\"rejected\"}[5m])", "legendFormat": "Rejected (503)", "refId": "C" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "title": "HTTP Traffic by Endpoint & Status",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (path, status) (rate(http_requests_total[5m]))", "legendFormat": "{{path}} ({{status}})", "refId": "A" }
      ]
    }
  ],
