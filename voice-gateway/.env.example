# ==============================================================================
# BloodNorms Voice Gateway — Environment Configuration Template (.env.example)
# ==============================================================================

# Server HTTP/WebSocket port (Cloud Run sets this automatically)
PORT=8080

# Environment mode: development | production | test
NODE_ENV=development

# Google Gemini API Key (Required for speech-to-speech requester assistant)
# Source: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Live bidirectional model name
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Shared secret token for authenticating Twilio Media Stream upgrades
# Must match VOICE_GATEWAY_SECRET in twilio-voice Supabase Edge Function
VOICE_GATEWAY_SECRET=voice_secret

