# ==============================================================================
# BLOODNORMS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (project root) and to assets/.env.
#
# IMPORTANT RULES:
#   - assets/.env ships inside the Flutter binary (APK / IPA / web bundle).
#     It must ONLY contain public/client-safe values:
#     SUPABASE_URL, SUPABASE_ANON_KEY, OSM/location defaults, and feature flags.
#   - NEVER put SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET,
#     WHATSAPP_ACCESS_TOKEN, GEMINI_API_KEY, or any server secret in assets/.env.
#   - Server secrets go ONLY in root .env (read by edge functions / voice-gateway
#     via their own runtime env, NOT via flutter_dotenv).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CORE CONFIGURATION
# Source: https://supabase.com/dashboard/project/<your-ref>/settings/api
# ------------------------------------------------------------------------------

# Your Supabase project REST endpoint
# Required | Example: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Client-safe anon public key (safe to include in app binary)
# Required | Supabase Dashboard → Settings → API → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder...

# Modern publishable key format (alternative to SUPABASE_ANON_KEY)
# Optional
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Service role SECRET key — NEVER put in assets/.env or client builds
# Required for server-side only: edge functions, voice-gateway, scripts
# Source: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret — server-side token verification only
# Required for server-side only: edge functions
# Source: Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# 2. MAPS & LOCATION SERVICES (OpenStreetMap — free, no API key needed)
# All map tiles and geocoding use OpenStreetMap / Nominatim (zero billing).
# ------------------------------------------------------------------------------

# OpenStreetMap tile server (default is public OSM)
# Optional | Change only if self-hosting tiles
OSM_TILE_SERVER=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Nominatim geocoding endpoint
# Optional | Change only if self-hosting Nominatim
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/

# Pilot city defaults (used as fallback when GPS is unavailable)
# Optional | Defaults to Rajahmundry, Andhra Pradesh
DEFAULT_PILOT_CITY=Rajahmundry
DEFAULT_PILOT_STATE=Andhra Pradesh
DEFAULT_PILOT_LAT=17.0005
DEFAULT_PILOT_LNG=81.7800

# ------------------------------------------------------------------------------
# 3. TELEPHONY & VOICE SERVICES
# Used by voice-gateway (Node.js) and supabase/functions/twilio-voice only.
# NEVER put these in assets/.env.
# Source: https://console.twilio.com
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Indian telecom fallback (Exotel / Kaleyra)
# Source: https://app.exotel.com
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=

# ------------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS CLOUD API (Meta Graph API)
# WHATSAPP_ACCESS_TOKEN is a SERVER secret — NEVER in assets/.env.
# Source: https://developers.facebook.com → Your App → WhatsApp → API Setup
# ------------------------------------------------------------------------------

# 15-digit Phone Number ID from Meta Developer Portal (not a phone number)
WHATSAPP_PHONE_NUMBER_ID=

# Meta Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=

# System User Access Token (server-side only — never in client bundle)
WHATSAPP_ACCESS_TOKEN=

# Webhook verify token (must match what you registered with Meta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE & VOICE GATEWAY
# GEMINI_API_KEY is a SERVER secret — used by voice-gateway only.
# NEVER put it in assets/.env.
# Source: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------

# Google Gemini API Key (voice-gateway only — never in Flutter app assets)
GEMINI_API_KEY=

# Google Cloud Service Account JSON for Speech-to-Text (voice-gateway only)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Daily AI voice usage budget cap (minutes)
# Optional | Default: 60
AI_VOICE_DAILY_MINUTES_CAP=60

# Voice Gateway WebSocket URL (used by twilio-voice edge function)
# Required for voice-gateway deployment
VOICE_GATEWAY_URL=wss://voice.bloodnorms.org/twilio/stream

# Shared secret for authenticating Twilio → voice-gateway WebSocket
VOICE_GATEWAY_SECRET=

# ------------------------------------------------------------------------------
# 6. APPLICATION SECURITY & OPERATIONAL CONTROLS
# ------------------------------------------------------------------------------

# Admin console PIN (optional — if empty, PIN gate is disabled)
ADMIN_CONSOLE_PIN=

# 24×7 emergency pilot helpline number displayed to users
EMERGENCY_HELPLINE_PHONE=+91 883 247 1234

# Environment mode: development | staging | production
APP_ENVIRONMENT=development

# Debug logging flag
DEBUG_MODE=false
